# ============================================================
# GOOGLE / GEMINI VEO
# ============================================================
# Gemini API Key (https://aistudio.google.com/app/apikey)
# Format: AIzaSy...
GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE

# ============================================================
# YOUTUBE (Google OAuth2)
# ============================================================
# 1. Gehe zu https://console.cloud.google.com
# 2. Erstelle ein Projekt, aktiviere "YouTube Data API v3"
# 3. Erstelle OAuth 2.0 Credentials (Desktop App)
# 4. Lade client_secret.json herunter und lege es hier ab
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
# Nach erstem Login wird dieser Token automatisch gespeichert:
YOUTUBE_TOKEN_FILE=youtube_token.json

# ============================================================
# INSTAGRAM REELS (Meta Graph API)
# ============================================================
# 1. https://developers.facebook.com → App erstellen
# 2. Instagram Graph API hinzufügen
# 3. Business Account verknüpfen
# 4. Long-lived Access Token generieren (60 Tage gültig)
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
INSTAGRAM_ACCOUNT_ID=YOUR_INSTAGRAM_ACCOUNT_ID

# ============================================================
# TIKTOK (Content Posting API)
# ============================================================
# 1. https://developers.tiktok.com → App erstellen
# 2. "Content Posting API" beantragen (Approval nötig)
# 3. OAuth Flow durchführen
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_ACCESS_TOKEN

# ============================================================
# KLING AI (kostenlose Alternative zu Veo)
# ============================================================
# 1. Account erstellen: https://platform.klingai.com
# 2. Unter "API Keys" → Access Key + Secret Key kopieren
KLING_ACCESS_KEY=DEIN_KLING_ACCESS_KEY
KLING_SECRET_KEY=DEIN_KLING_SECRET_KEY

# ============================================================
# AGENT EINSTELLUNGEN
# ============================================================
VIDEO_OUTPUT_DIR=./output
VIDEO_DURATION_SECONDS=15
VIDEO_ASPECT_RATIO=9:16
